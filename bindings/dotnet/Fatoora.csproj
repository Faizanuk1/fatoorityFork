<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageId>Fatoority</PackageId>
    <Version>0.4.1</Version>
    <Authors>mqqz</Authors>
    <Description>C# bindings for the Fatoora ZATCA SDK.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mqqz/fatoority</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="generated/**/*.cs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-MIT;../../LICENSE-APACHE;../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="$(NativeLibrary)" Pack="true" PackagePath="runtimes/$(NativeRid)/native/" Condition="'$(NativeLibrary)' != ''" />
    <None Include="$(NativeRoot)/runtimes/**/*" Pack="true" PackagePath="runtimes/" Condition="'$(NativeRoot)' != ''" />
  </ItemGroup>
  <Target Name="RequireNativeLibrary" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(NativeRoot)' == '' And ('$(NativeRid)' == '' Or '$(NativeLibrary)' == '' Or !Exists('$(NativeLibrary)'))" Text="Pack with NativeRid and NativeLibrary, or use scripts/package_dotnet.py." />
  </Target>
</Project>
